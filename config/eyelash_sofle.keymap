#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Texto {
            bindings = <
&kp GRAVE   &kp N1     &kp N2        &kp N3        &kp N4  &kp N5       &kp UP_ARROW     &kp N6     &kp N7  &kp N8         &kp N9     &kp N0            &kp SLASH
&kp ESCAPE  &kp Q      &kp W         &kp E         &kp R   &kp T        &kp DOWN_ARROW   &kp Y      &kp U   &kp I          &kp O      &kp P             &kp BACKSPACE
&kp TAB     &kp A      &kp S         &kp D         &kp F   &kp G        &kp LEFT_ARROW   &kp H      &kp J   &kp K          &kp L      &kp SINGLE_QUOTE  &kp ENTER
&kp LSHFT   &kp Z      &kp X         &kp C         &kp V   &kp B        &kp RIGHT_ARROW  &kp N      &kp M   &kp COMMA      &kp DOT    &kp SEMICOLON     &kp RIGHT_SHIFT
&kp C_MUTE  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_WIN  &mo 1   &kp SPACE    &kp ENTER        &kp SPACE  &mo 2   &kp RIGHT_ALT  &kp EQUAL  &kp MINUS
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
            display-name = "TEXTO";
        };

        Funciones {
            bindings = <
&none   &trans  &trans   &trans   &trans   &trans    &mmv MOVE_UP     &trans         &trans    &trans          &trans     &trans      &none
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &none     &mmv MOVE_DOWN   &kp PAGE_UP    &kp HOME  &kp UP_ARROW    &kp END    &kp INSERT  &kp DEL
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &none     &mmv MOVE_LEFT   &kp PAGE_DOWN  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT  &none       &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &none     &mmv MOVE_RIGHT  &none          &none     &none           &none      &none       &trans
&none   &trans  &trans   &trans   &none    &trans    &mkp LCLK        &trans         &mo 3     &trans          &none      &none
            >;

            display-name = "FUNCION";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        Simbolo {
            bindings = <
&kp TILDE  &kp EXCLAMATION  &kp AT_SIGN  &kp POUND   &kp DOLLAR   &kp PERCENT        &mmv MOVE_UP     &kp CARET  &kp AMPERSAND   &kp ASTERISK     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp NON_US_BACKSLASH
&trans     &none            &none        &none       &none        &none              &mmv MOVE_DOWN   &kp EQUAL  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp DEL
&trans     &none            &none        &none       &none        &none              &mmv MOVE_LEFT   &kp PLUS   &kp MINUS       &kp ASTRK        &kp FSLH              &kp GRAVE              &trans
&trans     &kp K_UNDO       &kp K_CUT    &kp K_COPY  &kp K_PASTE  &kp C_AC_SEARCH    &mmv MOVE_RIGHT  &kp TILDE  &none           &none            &none                 &none                  &trans
&none      &trans           &trans       &trans      &mo 3        &trans             &mkp LCLK        &trans     &none           &trans           &none                 &none
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
            display-name = "SIMBOLO";
        };

        Sistema {
            bindings = <
&out OUT_TOG                   &bt BT_SEL 0                    &bt BT_SEL 1                      &bt BT_SEL 2                       &bt BT_SEL 3     &bt BT_SEL 4       &none  &none  &none  &none  &none  &none  &none
&none                          &none                           &rgb_ug RGB_EFR                   &rgb_ug RGB_EFF                    &rgb_ug RGB_HUD  &rgb_ug RGB_HUI    &none  &none  &none  &none  &none  &none  &none
&rgb_ug RGB_OFF                &rgb_ug RGB_ON                  &rgb_ug RGB_SPD                   &rgb_ug RGB_SPI                    &rgb_ug RGB_SAD  &rgb_ug RGB_SAI    &none  &none  &none  &none  &none  &none  &none
&rgb_ug RGB_COLOR_HSB(0,4,98)  &rgb_ug RGB_COLOR_HSB(0,96,50)  &rgb_ug RGB_COLOR_HSB(240,97,49)  &rgb_ug RGB_COLOR_HSB(107,100,48)  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI    &none  &none  &none  &none  &none  &none  &none
&none                          &none                           &none                             &none                              &none            &none              &none  &none  &none  &none  &none  &none
            >;

            display-name = "SISTEMA";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
